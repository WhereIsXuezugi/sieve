<?xml version="1.0" encoding="utf-8"?>
<!-- Plain http is allowed because Sieve runs on 127.0.0.1 inside the app, or on
     a server on your home network, neither of which usually has a certificate. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
