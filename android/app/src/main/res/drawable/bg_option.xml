<?xml version="1.0" encoding="utf-8"?>
<!-- A choice in the "Where should Sieve run?" dialog: the web app's input
     look (paper, hairline, 3dp corners); the current choice is outlined in
     indigo. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_activated="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/paper" />
            <stroke android:width="2dp" android:color="@color/indigo" />
            <corners android:radius="3dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/paper" />
            <stroke android:width="1dp" android:color="@color/rule_2" />
            <corners android:radius="3dp" />
        </shape>
    </item>
</selector>
